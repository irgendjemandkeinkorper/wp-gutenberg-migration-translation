{
  "name": "wp-gutenberg-migration-translation",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/irgendjemandkeinkorper/wp-gutenberg-migration-translation.git"
  },
  "bugs": {
    "url": "https://github.com/irgendjemandkeinkorper/wp-gutenberg-migration-translation/issues"
  },
  "homepage": "https://irgendjemandkeinkorper.github.io/wp-gutenberg-migration-translation/",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "verify": "npm run build && npm test -- --reporter=dot && npm run test:checkpoint && npm run knowledge:check",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "test:checkpoint": "node integration/workspace/checkpoint-integration.mjs",
    "test:wordpress": "node integration/wordpress-harness/run.mjs",
    "fixtures:wordpress": "node integration/wordpress-harness/generate-fixtures.mjs --write",
    "fixtures:wordpress:check": "node integration/wordpress-harness/generate-fixtures.mjs --check",
    "knowledge:generate": "node scripts/generate-knowledge-vault.mjs --write",
    "knowledge:check": "node scripts/generate-knowledge-vault.mjs --check",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ui": "UI_TEST=true vitest run src/test/app.ui.test.tsx",
    "crawl": "node scripts/crawl.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@mozilla/readability": "^0.6.0",
    "nanoid": "^3.3.20",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "ajv": "^8.20.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.4.4",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "nanoid": "^3.3.18"
    }
  }
}
