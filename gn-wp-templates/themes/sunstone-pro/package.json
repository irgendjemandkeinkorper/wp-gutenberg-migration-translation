{
	"name": "sunstone-pro",
	"version": "1.0.0",
	"description": "Build setup for Sunstone Pro theme",
	"main": "index.js",
	"directories": {
		"lib": "lib"
	},
	"scripts": {
		"build": "rollup --environment NODE_ENV:production -c",
		"start": "rollup --environment NODE_ENV:development -c --watch"
	},
	"author": "Reaktiv Studios",
	"license": "ISC",
	"devDependencies": {
		"@babel/preset-env": "^7.16.11",
		"@babel/preset-react": "^7.16.7",
		"@rollup/plugin-babel": "^5.3.1",
		"@rollup/plugin-commonjs": "^21.1.0",
		"@rollup/plugin-node-resolve": "^13.2.1",
		"@rollup/plugin-replace": "^5.0.2",
		"@wordpress/babel-preset-default": "^6.8.0",
		"classnames": "^2.3.1",
		"eslint": "^7.25.0",
		"eslint-config-prettier": "^8.3.0",
		"eslint-plugin-prettier": "^3.4.0",
		"prettier": "^2.6.2",
		"prop-types": "^15.8.1",
		"rollup": "^2.70.2",
		"rollup-plugin-browsersync": "^1.3.3",
		"rollup-plugin-scss": "^3.0.0",
		"rollup-plugin-terser": "^7.0.2",
		"rollup-plugin-watcher": "^1.0.1",
		"rollup-plugin-wp-resolve": "^1.0.9",
		"sass": "^1.50.0"
	},
	"lint-staged": {
		"*.js": "eslint --fix",
		"*.{css,html,js,json,scss}": "prettier --write"
	},
	"postcss": {
		"plugins": {
			"autoprefixer": true
		}
	},
	"browserslist": [
		"defaults",
		"IE 10",
		"IE 11"
	],
	"dependencies": {
		"@popperjs/core": "^2.11.6",
		"bootstrap": "^5.2.3",
		"bootstrap-icons": "^1.10.3",
		"micromodal": "^0.4.10",
		"svgxuse": "^1.2.6"
	}
}
